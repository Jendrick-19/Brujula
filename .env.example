# Copia este archivo a .env y cambia los valores. No subas .env a Git.
POSTGRES_DB=brujula
POSTGRES_USER=brujula_admin
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_PORT=5432

# Usuario de la aplicación (permisos limitados)
APP_DB_USER=brujula_app
APP_DB_PASSWORD=cambia_esta_contrasena

# JWT
JWT_SECRET=genera_un_secreto_largo_y_aleatorio
JWT_EXPIRATION_MINUTES=60

# IA: ollama | external
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EXTERNAL_API_KEY=
